  coverageNotes:
  - "\u751F\u4EA7\u697C\u5C42=4;\u6218\u6597/\u5730\u56FE\u6309\u672C\u5173\u7A33\u5B9AID\u6536\u96C6\uFF1B\u5C01\u9762\u590D\u7528\u9996\u5C42\u5DF2\u9A8C\u6536\u80CC\u666F\u3002"
  - "\u672C\u5377+common\u5168\u90E8\u5361\u724C/\u82F1\u7075Vfx\u5B9A\u4E49\u53CA\u5176fallback\uFF1B\u4E0D\u521B\u5EFA\u6216\u5171\u4EAB\u53EF\u53D8CardConfig\u5B9E\u4F8B\u3002"
  - "\u5171\u4EABCardPresentation/EnemyAreaPresentation/AudioConfig\u7684\u786C\u5F15\u7528\u6309\u5F53\u524D\u5168\u5C40\u914D\u7F6E\u6536\u96C6\uFF0C\u53EF\u80FD\u5305\u542B\u5176\u5B83\u5173\u5361\u5171\u4EAB\u7D20\u6750\u3002"
  - "\u5173Boss\u4EC5\u52A0\u8F7D\u8F7B\u91CFruntime manifest\u58F0\u660E\u7684\u539F\u59CBatlas/audio\uFF1B\u4E0D\u63D0\u524D\u521B\u5EFASprite\u5207\u7247\u6216Infinity\u5B9E\u4F8B\u3002"
  - "Resources\u8D44\u6E90=416;\u7531\u7236\u8D44\u4EA7PPtr\u95F4\u63A5\u6301\u6709\u7684\u975EResources\u4F9D\u8D56=14\u3002"
